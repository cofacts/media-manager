{
  "version": "0.4.0",
  "license": "MIT",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsc -p tsconfig.build.json --watch",
    "build": "tsc -p tsconfig.build.json",
    "test": "jest",
    "lint": "eslint src test",
    "prepublishOnly": "npm run build"
  },
  "prettier": {
    "printWidth": 100,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "arrowParens": "avoid"
  },
  "name": "@cofacts/media-manager",
  "author": "Cofacts message reporting chatbot and crowd-sourced fact-checking community (「Cofacts 真的假的」訊息回報機器人與查證協作社群)",
  "repository": "github:cofacts/media-manager",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/content-type": "^1.1.5",
    "@types/jest": "^29.5.14",
    "@types/node-fetch": "^2.6.1",
    "@types/pngjs": "^6.0.5",
    "@types/serve-handler": "^6.1.1",
    "dotenv": "^16.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^4.2.5",
    "jest": "^29.7.0",
    "prettier": "^2.8.8",
    "serve-handler": "^6.1.3",
    "ts-jest": "^29.4.15",
    "tslib": "^2.4.0",
    "typedoc": "^0.27.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "@cwasm/webp": "^0.1.5",
    "@google-cloud/storage": "^7.22.0",
    "content-type": "^1.0.4",
    "jpeg-js": "^0.4.4",
    "node-fetch": "^2.6.7",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5"
  },
  "keywords": [
    "Multimedia information retrieval",
    "Image search",
    "Near-duplicate image search",
    "Multimedia indexing"
  ],
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "snapshotFormat": {
      "escapeString": true,
      "printBasicPrototype": true
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "diagnostics": {
            "ignoreCodes": [
              151002
            ]
          }
        }
      ]
    }
  }
}
